# Always Us — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- App ---
APP_ENV=development
SECRET_KEY=CHANGE_ME_use_a_long_random_string_at_least_32_chars

# --- Database ---
# SQLite (default for local use)
DATABASE_URL=sqlite+aiosqlite:///./data/always_us.db

# PostgreSQL (for remote hosting, uncomment and fill in)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/always_us

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- Auth ---
# Simple access passcode (hashed at startup). Set a strong value.
ACCESS_PASSCODE=CHANGE_ME_set_a_strong_passcode
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
# Comma-separated allowed origins for the frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- API ---
API_V1_PREFIX=/api/v1
